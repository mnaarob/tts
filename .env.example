# Copy to `.env.local` for local development (never commit `.env.local`).
# Supabase — publishable (anon) key only; never put the service role / secret key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key-here

# Cloudflare Turnstile site key (public). Required when Supabase Auth has CAPTCHA enabled.
# Create a widget at https://dash.cloudflare.com/ → Turnstile; allow localhost for local dev.
# The Turnstile *secret* key belongs only in:
#   - Supabase Dashboard → Authentication → Bot and Abuse Protection
#   - Supabase Edge Function secret: TURNSTILE_SECRET_KEY (for employee signup)
#   - Local only: TURNSTILE_SECRET_KEY in .env.local (run scripts/setup-supabase-secrets.sh)
VITE_TURNSTILE_SITE_KEY=

# Server-side only — never commit. Used by scripts/setup-supabase-secrets.sh
TURNSTILE_SECRET_KEY=

# Namecheap Private Email SMTP — set these in Vercel → Settings → Environment Variables
# (Production) so /api/contact works on phones. Never commit real passwords.
# Typical: SMTP_HOST=mail.privateemail.com  SMTP_PORT=465  SMTP_USER=contact@techtostore.com
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_USER=contact@techtostore.com
SMTP_PASS=
CONTACT_TO=contact@techtostore.com

# Optional alternative to SMTP (https://web3forms.com — free access key emailed to you)
WEB3FORMS_ACCESS_KEY=
